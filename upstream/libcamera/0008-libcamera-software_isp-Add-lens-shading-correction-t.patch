diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 3ba794a..cb59b2c 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -39,6 +39,21 @@ struct DebayerParams {
 		float noiseFloor = 0.0;
 		float motionSigma = 0.0;
 	} temporalDenoise;
+	/*
+	 * Lens shading correction: per-channel gains on a grid of
+	 * width x height cells spread over the whole frame, interpolated
+	 * between the cell centres and applied right after the black level
+	 * subtraction. A width or height of 0 disables the correction. The
+	 * gains are stored row by row, R, G and B interleaved, so that the
+	 * parameters stay a plain object in the shared memory.
+	 */
+	struct Lsc {
+		static constexpr unsigned int kMaxWidth = 32;
+		static constexpr unsigned int kMaxHeight = 32;
+		unsigned int width = 0;
+		unsigned int height = 0;
+		float gains[kMaxWidth * kMaxHeight * 3] = {};
+	} lsc;
 };
 
 } /* namespace libcamera */
diff --git a/src/ipa/softisp/algorithms/lsc.cpp b/src/ipa/softisp/algorithms/lsc.cpp
new file mode 100644
index 0000000..9325f57
--- /dev/null
+++ b/src/ipa/softisp/algorithms/lsc.cpp
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Robert Bozik
+ *
+ * Lens shading correction table
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <string.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftIspLsc)
+
+namespace ipa::softisp::algorithms {
+
+/*
+ * The tuning file provides a grid of gains measured on a uniformly lit
+ * flat field, one table per colour channel:
+ *
+ *   - Lsc:
+ *       grid: [ columns, rows ]
+ *       r: [ ... ]     # columns * rows values, row by row
+ *       g: [ ... ]
+ *       b: [ ... ]
+ *
+ * Each value is the gain that brings the cell back to the brightness of
+ * the frame centre for that channel; the centre is therefore 1.0 and the
+ * global colour balance is left to the AWB. The gains are interpolated
+ * between the cell centres by the ISP and applied after the black level
+ * subtraction, before the white balance gains.
+ */
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	const auto grid = tuningData["grid"].get<std::vector<unsigned int>>();
+	if (!grid || grid->size() != 2) {
+		LOG(IPASoftIspLsc, Error) << "grid must be [ columns, rows ]";
+		return -EINVAL;
+	}
+
+	width_ = (*grid)[0];
+	height_ = (*grid)[1];
+	if (width_ < 2 || height_ < 2 ||
+	    width_ > DebayerParams::Lsc::kMaxWidth ||
+	    height_ > DebayerParams::Lsc::kMaxHeight) {
+		LOG(IPASoftIspLsc, Error)
+			<< "grid " << width_ << "x" << height_
+			<< " out of range (2.." << DebayerParams::Lsc::kMaxWidth
+			<< " x 2.." << DebayerParams::Lsc::kMaxHeight << ")";
+		return -EINVAL;
+	}
+
+	const unsigned int cells = width_ * height_;
+	gains_.assign(cells * 3, 1.0f);
+
+	const char *keys[3] = { "r", "g", "b" };
+	for (unsigned int c = 0; c < 3; c++) {
+		const auto table = tuningData[keys[c]].get<std::vector<double>>();
+		if (!table || table->size() != cells) {
+			LOG(IPASoftIspLsc, Error)
+				<< "table '" << keys[c] << "' must have "
+				<< cells << " values";
+			return -EINVAL;
+		}
+
+		for (unsigned int i = 0; i < cells; i++) {
+			const double gain = (*table)[i];
+			if (gain <= 0.0 || gain > 16.0) {
+				LOG(IPASoftIspLsc, Error)
+					<< "table '" << keys[c] << "' value "
+					<< gain << " out of range ]0, 16]";
+				return -EINVAL;
+			}
+			gains_[i * 3 + c] = gain;
+		}
+	}
+
+	LOG(IPASoftIspLsc, Info)
+		<< "Lens shading grid " << width_ << "x" << height_
+		<< ", max gain " << *std::max_element(gains_.begin(), gains_.end());
+
+	return 0;
+}
+
+void Lsc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	params->lsc.width = width_;
+	params->lsc.height = height_;
+	memcpy(params->lsc.gains, gains_.data(),
+	       gains_.size() * sizeof(float));
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
