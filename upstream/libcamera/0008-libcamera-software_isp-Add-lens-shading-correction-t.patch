diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 0b641a5..4a98506 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -70,6 +70,14 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+/*
+ * Lens shading: gains on a coarse grid, one texel per cell, stored as
+ * (gain - lsc_min) / lsc_range per channel; lsc_on is 0.0 or 1.0.
+ */
+uniform sampler2D tex_lsc;
+uniform vec3 lsc_min;
+uniform vec3 lsc_range;
+uniform float lsc_on;
 
 float apply_contrast(float value)
 {
@@ -232,6 +240,9 @@ void main(void)
 	 */
 	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
 
+	/* Lens shading correction */
+	rgb *= mix(vec3(1.0), lsc_min + lsc_range * texture2D(tex_lsc, (center_pixel + 0.5) / tex_size).rgb, lsc_on);
+
 	/* Apply AWB gains, and saturate each channel at sensor range */
 	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
 
