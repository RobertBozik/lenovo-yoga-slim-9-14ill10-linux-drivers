diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index 913685b..91dd95d 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -11,8 +11,10 @@
 
 #include <algorithm>
 #include <assert.h>
+#include <cmath>
 #include <memory>
 #include <stdlib.h>
+#include <string.h>
 #include <string>
 #include <tuple>
 #include <vector>
@@ -108,6 +110,10 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	lscUniformTexture_ = glGetUniformLocation(programId_, "tex_lsc");
+	lscUniformMin_ = glGetUniformLocation(programId_, "lsc_min");
+	lscUniformRange_ = glGetUniformLocation(programId_, "lsc_range");
+	lscUniformOn_ = glGetUniformLocation(programId_, "lsc_on");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -502,9 +508,96 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform1f(contrastExpUniformDataIn_, params.contrastExp);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	setLensShading(params.lsc);
+
 	return;
 }
 
+/*
+ * Upload the lens shading table as an RGB8 texture with one texel per
+ * cell, linearly filtered so that the shader gets the gains interpolated
+ * between the cell centres. The gains are stored as (gain - min) / range
+ * per channel to keep the 8-bit precision. The texture is only re-uploaded
+ * when the table changes.
+ */
+void DebayerEGL::setLensShading(const DebayerParams::Lsc &lsc)
+{
+	const bool enabled = lsc.width >= 2 && lsc.height >= 2 &&
+			     lsc.width <= DebayerParams::Lsc::kMaxWidth &&
+			     lsc.height <= DebayerParams::Lsc::kMaxHeight;
+
+	glUniform1f(lscUniformOn_, enabled ? 1.0f : 0.0f);
+	if (!enabled)
+		return;
+
+	const unsigned int cells = lsc.width * lsc.height;
+	const bool changed = !lscTexture_ ||
+			     lscCached_.width != lsc.width ||
+			     lscCached_.height != lsc.height ||
+			     memcmp(lscCached_.gains, lsc.gains,
+				    cells * 3 * sizeof(float)) != 0;
+
+	if (changed) {
+		float minGain[3], maxGain[3];
+		for (unsigned int c = 0; c < 3; c++) {
+			minGain[c] = lsc.gains[c];
+			maxGain[c] = lsc.gains[c];
+		}
+		for (unsigned int i = 0; i < cells; i++) {
+			for (unsigned int c = 0; c < 3; c++) {
+				minGain[c] = std::min(minGain[c], lsc.gains[i * 3 + c]);
+				maxGain[c] = std::max(maxGain[c], lsc.gains[i * 3 + c]);
+			}
+		}
+		for (unsigned int c = 0; c < 3; c++) {
+			lscMin_[c] = minGain[c];
+			lscRange_[c] = std::max(maxGain[c] - minGain[c], 1e-6f);
+		}
+
+		std::vector<uint8_t> texels(cells * 3);
+		for (unsigned int i = 0; i < cells * 3; i++) {
+			float v = (lsc.gains[i] - lscMin_[i % 3]) / lscRange_[i % 3];
+			texels[i] = static_cast<uint8_t>(std::lround(std::clamp(v, 0.0f, 1.0f) * 255.0f));
+		}
+
+		if (!lscTexture_ || lscCached_.width != lsc.width ||
+		    lscCached_.height != lsc.height)
+			lscTexture_ = std::make_unique<eGLImage>(GL_RGB, lsc.width, lsc.height,
+								 lsc.width * 3,
+								 GL_TEXTURE4, 4);
+
+		egl_.activateBindTexture(*lscTexture_);
+		glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, lsc.width, lsc.height, 0,
+			     GL_RGB, GL_UNSIGNED_BYTE, texels.data());
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+
+		GLenum err = glGetError();
+		if (err != GL_NO_ERROR) {
+			LOG(Debayer, Error) << "Lens shading texture error " << err;
+			lscTexture_.reset();
+			glUniform1f(lscUniformOn_, 0.0f);
+			return;
+		}
+
+		lscCached_ = lsc;
+		LOG(Debayer, Info)
+			<< "Lens shading table " << lsc.width << "x" << lsc.height
+			<< " gains R " << minGain[0] << ".." << maxGain[0]
+			<< " G " << minGain[1] << ".." << maxGain[1]
+			<< " B " << minGain[2] << ".." << maxGain[2];
+	}
+
+	egl_.activateBindTexture(*lscTexture_);
+	glUniform1i(lscUniformTexture_, lscTexture_->texture_unit_uniform_id_);
+	glUniform3fv(lscUniformMin_, 1, lscMin_);
+	glUniform3fv(lscUniformRange_, 1, lscRange_);
+}
