 /*
  * Lens shading: gains on a coarse grid, one texel per cell, stored as
@@ -259,7 +262,8 @@ void main(void)
 	rgb.b = apply_contrast(rgb.b);
 
 	/* Apply gamma after colour correction */
-	rgb = pow(rgb, vec3(gamma));
+	rgb = mix((1.0 + gammaOffset) * pow(rgb, vec3(gamma)) - gammaOffset,
+	          toeSlope * rgb, step(rgb, vec3(toeThreshold)));
 
 #if defined (SWAP_BLUE)
 	gl_FragColor = vec4(rgb.bgr, 1.0);
