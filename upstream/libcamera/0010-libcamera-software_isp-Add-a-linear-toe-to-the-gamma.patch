 .../internal/software_isp/debayer_params.h    |  9 +++++
 src/ipa/softisp/algorithms/adjust.cpp         | 33 ++++++++++++++++++-
 src/ipa/softisp/algorithms/adjust.h           |  2 ++
 src/libcamera/shaders/bayer_1x_packed.frag    |  6 +++-
 src/libcamera/shaders/bayer_unpacked.frag     |  6 +++-
 src/libcamera/software_isp/debayer_cpu.cpp    | 10 +++++-
 src/libcamera/software_isp/debayer_egl.cpp    | 10 +++++-
 src/libcamera/software_isp/debayer_egl.h      |  3 ++
 8 files changed, 74 insertions(+), 5 deletions(-)

diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index cb59b2c..dce3849 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -23,6 +23,15 @@ struct DebayerParams {
 						 0.0, 0.0, 1.0 } };
 	RGB<double> blackLevel = RGB<double>({ 0.0, 0.0, 0.0 });
 	float gamma = 1.0;
+	/*
+	 * Linear toe of the gamma curve, sRGB style: below toeThreshold the
+	 * output is toeSlope * input, above it (1 + gammaOffset) * input ^
+	 * gamma - gammaOffset. A gammaOffset of 0 gives the plain power
+	 * function.
+	 */
+	float gammaOffset = 0.0;
+	float toeThreshold = 0.0;
+	float toeSlope = 1.0;
 	float contrastExp = 1.0;
 	RGB<double> gains = RGB<double>({ 1.0, 1.0, 1.0 });
 	/*
diff --git a/src/ipa/softisp/algorithms/adjust.cpp b/src/ipa/softisp/algorithms/adjust.cpp
index 56e2cf0..5aaf115 100644
--- a/src/ipa/softisp/algorithms/adjust.cpp
+++ b/src/ipa/softisp/algorithms/adjust.cpp
@@ -8,6 +8,8 @@
 
 #include "adjust.h"
 
+#include <cmath>
+
 #include <libcamera/base/log.h>
 #include <libcamera/base/utils.h>
 
@@ -24,8 +26,26 @@ constexpr float kDefaultSaturation = 1.0f;
 
 LOG_DEFINE_CATEGORY(IPASoftIspAdjust)
 
-int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+/*
+ * A plain power function has an infinite slope at zero, which amplifies the
+ * noise and the clipping bias of the darkest tones. The tuning file can add
+ * a linear toe to the curve with gammaOffset, in the style of the sRGB
+ * transfer function (whose offset is 0.055): the curve becomes
+ * (1 + offset) * x ^ (1 / gamma) - offset above the threshold where its
+ * slope matches the linear segment through the origin, and that linear
+ * segment below it.
+ */
+static constexpr float kDefaultGammaOffset = 0.0f;
+
+int Adjust::init(IPAContext &context, const ValueNode &tuningData)
 {
+	gammaOffset_ = tuningData["gammaOffset"].get<double>(kDefaultGammaOffset);
+	if (gammaOffset_ < 0.0f || gammaOffset_ >= 1.0f) {
+		LOG(IPASoftIspAdjust, Warning)
+			<< "gammaOffset must be in [0, 1[, ignored";
+		gammaOffset_ = kDefaultGammaOffset;
+	}
+
 	context.ctrlMap[&controls::Gamma] =
 		ControlInfo(0.1f, 10.0f, kDefaultGamma);
 	context.ctrlMap[&controls::Contrast] =
@@ -107,6 +127,17 @@ void Adjust::prepare(IPAContext &context,
 	}
 
 	params->gamma = 1.0 / context.activeState.knobs.gamma;
+	params->gammaOffset = 0.0f;
+	params->toeThreshold = 0.0f;
+	params->toeSlope = 1.0f;
+	if (gammaOffset_ > 0.0f && params->gamma < 1.0f) {
+		const double a = gammaOffset_;
+		const double g = params->gamma;
+		const double t = std::pow(a / ((1.0 + a) * (1.0 - g)), 1.0 / g);
+		params->gammaOffset = a;
+		params->toeThreshold = t;
+		params->toeSlope = ((1.0 + a) * std::pow(t, g) - a) / t;
+	}
 	const float contrast = context.activeState.knobs.contrast.value_or(kDefaultContrast);
 	params->contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
 }
