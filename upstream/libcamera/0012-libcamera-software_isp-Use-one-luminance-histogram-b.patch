From d3c1ced6785469f6ad05a60ed2d138f40690abeb Mon Sep 17 00:00:00 2001
From: Robert Bozik <robertbozik@gmail.com>
Date: Wed, 26 Aug 2026 16:24:50 +0000
Subject: [PATCH] libcamera: software_isp: Use one luminance histogram bin per
 10-bit level

The 64-bin luminance histogram spans 16 raw levels per bin, and the
whole dark end of a dark scene lands in the first bin above the black
level: the veil and the highlight of such a scene sit within a few raw
levels of it and cannot be located.

Use one bin per 10-bit level and derive the black level index from the
number of bins per 8-bit level instead of the (now zero) inverse ratio.
8-bit inputs simply leave every fourth bin empty.

Assisted-by: Claude:claude-fable-5 [Claude Code]
---
 include/libcamera/internal/software_isp/swisp_stats.h | 10 +++++++++-
 src/ipa/softisp/algorithms/agc.cpp                    |  2 +-
 src/ipa/softisp/algorithms/blc.cpp                    |  9 ++++-----
 3 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index d9d0d9b..3428298 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -33,8 +33,16 @@ struct SwIspStats {
 	RGB<uint64_t> sum_;
 	/**
 	 * \brief Number of bins in the yHistogram
+	 *
+	 * One bin per 10-bit luminance level, so that the darkest tones of a
+	 * dark scene, which sit within a few levels of the black level, can
+	 * still be told apart.
 	 */
-	static constexpr unsigned int kYHistogramSize = 64;
+	static constexpr unsigned int kYHistogramSize = 1024;
+	/**
+	 * \brief Number of yHistogram bins per 8-bit luminance level
+	 */
+	static constexpr unsigned int kYHistogramBinsPerLevel = kYHistogramSize / 256;
 	/**
 	 * \brief Type of the histogram.
 	 */
diff --git a/src/ipa/softisp/algorithms/agc.cpp b/src/ipa/softisp/algorithms/agc.cpp
index e9f82be..632d8b5 100644
--- a/src/ipa/softisp/algorithms/agc.cpp
+++ b/src/ipa/softisp/algorithms/agc.cpp
@@ -453,7 +453,7 @@ void Agc::process(IPAContext &context,
 	 */
 	const auto &histogram = stats->yHistogram;
 	const unsigned int blackLevelHistIdx =
-		context.activeState.blc.level / (256 / SwIspStats::kYHistogramSize);
+		context.activeState.blc.level * SwIspStats::kYHistogramBinsPerLevel;
 	const unsigned int histogramSize =
 		SwIspStats::kYHistogramSize - blackLevelHistIdx;
 	const unsigned int yHistValsPerBin = histogramSize / kExposureBinsCount;
diff --git a/src/ipa/softisp/algorithms/blc.cpp b/src/ipa/softisp/algorithms/blc.cpp
index f190de6..f38f6af 100644
--- a/src/ipa/softisp/algorithms/blc.cpp
+++ b/src/ipa/softisp/algorithms/blc.cpp
@@ -143,16 +143,16 @@ void BlackLevel::process(IPAContext &context,
 	}
 
 	const unsigned int pixelThreshold = ignoredPercentage * total;
-	const unsigned int histogramRatio = 256 / SwIspStats::kYHistogramSize;
+	const unsigned int binsPerLevel = SwIspStats::kYHistogramBinsPerLevel;
 	const unsigned int currentBlackIdx =
-		context.activeState.blc.level / histogramRatio;
+		context.activeState.blc.level * binsPerLevel;
 
 	for (unsigned int i = 0, seen = 0;
 	     i < currentBlackIdx && i < SwIspStats::kYHistogramSize;
 	     i++) {
 		seen += histogram[i];
 		if (seen >= pixelThreshold) {
-			context.activeState.blc.level = i * histogramRatio;
+			context.activeState.blc.level = i / binsPerLevel;
 			context.activeState.blc.lastExposure = frameContext.sensor.exposure;
 			context.activeState.blc.lastGain = frameContext.sensor.gain;
 			LOG(IPASoftIspBL, Debug)
@@ -169,9 +169,8 @@ void BlackLevel::updateVeil(IPAContext &context, IPAFrameContext &frameContext,
 			    const SwIspStats *stats)
 {
 	const SwIspStats::Histogram &histogram = stats->yHistogram;
-	const unsigned int histogramRatio = 256 / SwIspStats::kYHistogramSize;
 	const unsigned int blackIdx = std::min<unsigned int>(
-		context.activeState.blc.level / histogramRatio,
+		context.activeState.blc.level * SwIspStats::kYHistogramBinsPerLevel,
 		SwIspStats::kYHistogramSize - 1);
 	const unsigned int size = SwIspStats::kYHistogramSize - blackIdx;
 
-- 
