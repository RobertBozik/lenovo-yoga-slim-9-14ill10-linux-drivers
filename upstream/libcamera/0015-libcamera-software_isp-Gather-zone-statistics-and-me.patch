diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index 3428298..1b776d0 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -51,6 +51,38 @@ struct SwIspStats {
 	 * \brief A histogram of luminance values of all the sampled pixels
 	 */
 	Histogram yHistogram;
+	/**
+	 * \brief Number of zones across and down the statistics window
+	 */
+	static constexpr unsigned int kZonesX = 16;
+	static constexpr unsigned int kZonesY = 9;
+	/**
+	 * \brief The central zones, kCentreX0 <= x < kCentreX1 and likewise
+	 * for y, whose luminance is also gathered in yHistogramCentre
+	 */
+	static constexpr unsigned int kCentreX0 = 4;
+	static constexpr unsigned int kCentreX1 = 12;
+	static constexpr unsigned int kCentreY0 = 2;
+	static constexpr unsigned int kCentreY1 = 7;
+	/**
+	 * \brief Per-zone sums of the sampled pixels, row by row
+	 */
+	struct Zone {
+		uint32_t sumR, sumG, sumB;
+		uint32_t count;
+	};
+	std::array<Zone, kZonesX * kZonesY> zones;
+	/**
+	 * \brief Right shift that brings the zone sums to the 8-bit scale
+	 *
+	 * The zone sums are accumulated at the bit depth of the input format,
+	 * unlike sum_ which is already shifted.
+	 */
+	unsigned int zoneShift;
+	/**
+	 * \brief A histogram of luminance values of the central zones
+	 */
+	Histogram yHistogramCentre;
 };
 
 } /* namespace libcamera */
