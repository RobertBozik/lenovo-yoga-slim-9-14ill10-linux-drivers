+/*
+ * Besides the frame totals, accumulate the sample into its zone (one per
+ * 4 pixels, samplesPerLine_ per line) and, for the central zones, into
+ * the second luminance histogram.
+ */
+#define SWSTATS_ACCUMULATE_LINE_STATS(div)                                      \
+	sumR += r;                                                              \
+	sumG += g;                                                              \
+	sumB += b;                                                              \
+                                                                                \
+	yVal = r * kRedYMul;                                                    \
+	yVal += g * kGreenYMul;                                                 \
+	yVal += b * kBlueYMul;                                                  \
+	yBin = yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div));        \
+	stats.yHistogram[yBin]++;                                               \
+	{                                                                       \
+		const unsigned int zx = std::min(sample * SwIspStats::kZonesX / \
+							 samplesPerLine_,       \
+						 SwIspStats::kZonesX - 1);      \
+		SwIspStats::Zone &zone = zoneRow[zx];                           \
+		zone.sumR += r;                                                 \
+		zone.sumG += g;                                                 \
+		zone.sumB += b;                                                 \
+		zone.count++;                                                   \
+		if (centreRow && zx >= SwIspStats::kCentreX0 &&                 \
+		    zx < SwIspStats::kCentreX1)                                 \
+			stats.yHistogramCentre[yBin]++;                         \
+		sample++;                                                       \
+	}
 
