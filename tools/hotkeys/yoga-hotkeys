#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""On-screen messages for the Lenovo Yoga Slim 9 14ILL10 hotkeys.

Windows shows a popup when the camera switch is flipped or the
performance key is pressed; under Linux both work but nothing says so.
This session service shows the same kind of message.

Camera switch. It cuts the picture in hardware: the sensor keeps
streaming, every pixel is zero, and nothing reports an error. The
embedded controller reports it on "Ideapad extra buttons" as scan code
0x10c (camera on) or 0x10d (camera off). ideapad-laptop has no key for
either, so they arrive as KEY_UNKNOWN and cannot be remapped through
hwdb (EVIOCSKEYCODE rejects scan codes the sparse keymap does not know).
The scan code is unambiguous, so it is read directly from the device,
which a udev rule makes readable for the logged-in user.

Performance key. The firmware cycles the platform profile itself
(balanced -> performance -> low-power) and sends no key. The kernel
does notify sysfs readers of /sys/firmware/acpi/platform_profile, so a
change shows up as an exceptional condition on poll(). A change made
anywhere else, e.g. in the Plasma battery applet, is shown as well.

The message goes to the Plasma OSD (the volume-change popup) when Plasma
is running, and to an ordinary desktop notification otherwise.
"""
import os
import select
import struct
import subprocess
import sys

KEYS_DEV = "/dev/input/yoga-hotkeys"
PROFILE = "/sys/firmware/acpi/platform_profile"

EV_MSC, MSC_SCAN = 4, 4
SCAN_CAMERA_ON, SCAN_CAMERA_OFF = 0x10C, 0x10D

# struct input_event: struct timeval, __u16 type, __u16 code, __s32 value
EVENT = struct.Struct("llHHi")

# message id -> (icon, {language: text})
MESSAGES = {
    "camera-on": ("camera-on", {
        "en": "Camera on", "sk": "Kamera zapnutá", "cs": "Kamera zapnuta"}),
    "camera-off": ("camera-off", {
        "en": "Camera off", "sk": "Kamera vypnutá", "cs": "Kamera vypnuta"}),
    "performance": ("power-profile-performance-symbolic", {
        "en": "Performance", "sk": "Výkon", "cs": "Výkon"}),
    "balanced": ("power-profile-balanced-symbolic", {
        "en": "Balanced", "sk": "Vyvážený", "cs": "Vyvážený"}),
    "low-power": ("power-profile-power-saver-symbolic", {
        "en": "Power saver", "sk": "Úspora energie", "cs": "Úspora energie"}),
}
SCANS = {SCAN_CAMERA_ON: "camera-on", SCAN_CAMERA_OFF: "camera-off"}


def language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "")
        if value:
            return value.split("_")[0].split(".")[0]
    return "en"


def busctl(*args):
    try:
        return subprocess.run(["busctl", "--user", "call", *args],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def show(message):
    icon, texts = MESSAGES[message]
    text = texts.get(language(), texts["en"])
    if busctl("org.kde.plasmashell", "/org/kde/osdService",
              "org.kde.osdService", "showText", "ss", icon, text):
        return
    # Notify(app_name, replaces_id, icon, summary, body, actions, hints, timeout)
    busctl("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
           "org.freedesktop.Notifications", "Notify", "susssasa{sv}i",
           "yoga-hotkeys", "0", icon, text, "", "0", "0", "2000")


def read_profile(f):
    f.seek(0)
    return f.read().strip()


def main():
    poller = select.poll()
    keys = profile = None
    last_profile = None

    try:
        keys = open(KEYS_DEV, "rb", buffering=0)
        poller.register(keys, select.POLLIN)
    except OSError as e:
        print("no camera switch: %s" % e, file=sys.stderr)

    try:
        profile = open(PROFILE)
        # Read before polling: sysfs reports a change only to readers
        # that have read the attribute since the last notification.
        last_profile = read_profile(profile)
        poller.register(profile, select.POLLPRI | select.POLLERR)
    except OSError as e:
        print("no platform profile: %s" % e, file=sys.stderr)

    if keys is None and profile is None:
        return 1

    while True:
        for fd, _ in poller.poll():
            if keys is not None and fd == keys.fileno():
                data = keys.read(EVENT.size)
                if len(data) < EVENT.size:
                    # The device went away; let systemd restart us.
                    return 1
                _, _, etype, code, value = EVENT.unpack(data)
                if etype == EV_MSC and code == MSC_SCAN and value in SCANS:
                    show(SCANS[value])
            elif profile is not None and fd == profile.fileno():
                now = read_profile(profile)
                if now != last_profile and now in MESSAGES:
                    show(now)
                last_profile = now


if __name__ == "__main__":
    sys.exit(main())
