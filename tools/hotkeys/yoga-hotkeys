# SPDX-License-Identifier: GPL-2.0
"""On-screen messages for the Lenovo Yoga Slim 9 14ILL10 hotkeys.

Windows shows a popup when the camera switch is flipped or the
performance key is pressed; under Linux both work but nothing says so.
This session service shows the same kind of message.

Camera switch. It cuts the picture in hardware: the sensor keeps
streaming, every pixel is zero, and nothing reports an error. The
embedded controller reports it on "Ideapad extra buttons" as scan code
0x10c (camera on) or 0x10d (camera off). ideapad-laptop has no key for
either, so they arrive as KEY_UNKNOWN and cannot be remapped through
hwdb (EVIOCSKEYCODE rejects scan codes the sparse keymap does not know).
The scan code is unambiguous, so it is read directly from the device,
which a udev rule makes readable for the logged-in user.

Performance key. The firmware cycles the platform profile itself
(balanced -> performance -> low-power) and sends no key. The kernel
does notify sysfs readers of /sys/firmware/acpi/platform_profile, so a
change shows up as an exceptional condition on poll(). A change made
anywhere else, e.g. in the Plasma battery applet, is shown as well.
Like the Windows energy saver, entering low-power also dims the screen
by DIM, and leaving it puts the brightness back - unless it was changed
by hand in the meantime, in which case it is left as it is.

Star keys. Under Windows the two star keys (KEY_PROG1 on the right,
KEY_FAVORITES next to F12) are left for the user to assign. In Plasma a
press on one that has no global shortcut yet opens the shortcut
settings, so it is obvious what to do; once a shortcut is assigned,
Plasma runs it and this service stays out of the way.

The message goes to the Plasma OSD (the volume-change popup) when Plasma
is running, and to an ordinary desktop notification otherwise.
"""
import os
import select
import struct
import subprocess
import sys

KEYS_DEV = "/dev/input/yoga-hotkeys"
PROFILE = "/sys/firmware/acpi/platform_profile"

# How much darker the screen gets in low-power (Windows uses 30 %).
DIM = 0.30
BRIGHTNESS = ("org.kde.Solid.PowerManagement",
              "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
              "org.kde.Solid.PowerManagement.Actions.BrightnessControl")

EV_KEY, EV_MSC, MSC_SCAN = 1, 4, 4
SCAN_CAMERA_ON, SCAN_CAMERA_OFF = 0x10C, 0x10D

# struct input_event: struct timeval, __u16 type, __u16 code, __s32 value
EVENT = struct.Struct("llHHi")

# message id -> (icon, {language: text})
MESSAGES = {
    "camera-on": ("camera-on", {
        "en": "Camera on", "sk": "Kamera zapnutá", "cs": "Kamera zapnuta"}),
    "camera-off": ("camera-off", {
        "en": "Camera off", "sk": "Kamera vypnutá", "cs": "Kamera vypnuta"}),
    "performance": ("power-profile-performance-symbolic", {
        "en": "Performance", "sk": "Výkon", "cs": "Výkon"}),
    "balanced": ("power-profile-balanced-symbolic", {
        "en": "Balanced", "sk": "Vyvážený", "cs": "Vyvážený"}),
    "low-power": ("power-profile-power-saver-symbolic", {
        "en": "Power saver", "sk": "Úspora energie", "cs": "Úspora energie"}),
    "unassigned": ("input-keyboard", {
        "en": "No shortcut on this key yet",
        "sk": "Kláves zatiaľ nemá priradenú skratku",
        "cs": "Klávesa zatím nemá přiřazenou zkratku"}),
}
SCANS = {SCAN_CAMERA_ON: "camera-on", SCAN_CAMERA_OFF: "camera-off"}

# Star keys: evdev key code -> Qt key code, as Plasma stores the shortcut
# (read back from kglobalaccel after assigning the keys by hand).
KEY_PROG1, KEY_FAVORITES = 148, 364
STAR_KEYS = {KEY_PROG1: 16777379,       # Qt::Key_Launch1, "Launch (1)"
             KEY_FAVORITES: 16777361}   # Qt::Key_Favorites
KGLOBALACCEL = ("org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel")


def language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "")
        if value:
            return value.split("_")[0].split(".")[0]
    return "en"


def busctl_out(*args):
    """Output of a busctl call, or None if it failed."""
    try:
        r = subprocess.run(["busctl", "--user", "call", *args],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def busctl(*args):
    return busctl_out(*args) is not None


def brightness_get(method):
    """An integer from Plasma's brightness control ("i 1234"), or None."""
    out = busctl_out(*BRIGHTNESS, method)
    try:
        return int(out.split()[1])
    except (AttributeError, IndexError, ValueError):
        return None


def brightness_set(value):
    # Silent: the power mode message is already on screen.
    busctl(*BRIGHTNESS, "setBrightnessSilent", "i", str(value))


class Dimmer:
    """Dims the screen in low-power and undoes it afterwards."""

    def __init__(self):
        self.saved = self.dimmed_to = None

    def enter(self):
        now = brightness_get("brightness")
        if now is None:
            return                      # not Plasma: leave the screen alone
        floor = brightness_get("knownSafeBrightnessMin") or 1
        target = max(floor, round(now * (1 - DIM)))
        if target >= now:
            return
        brightness_set(target)
        self.saved, self.dimmed_to = now, target

    def leave(self):
        if self.saved is None:
            return
        now = brightness_get("brightness")
        top = brightness_get("brightnessMax") or 100
        # Put it back only if nobody touched it; allow 1 % for rounding.
        if now is not None and abs(now - self.dimmed_to) <= max(1, top // 100):
            brightness_set(self.saved)
        self.saved = self.dimmed_to = None


def show(message):
    icon, texts = MESSAGES[message]
    text = texts.get(language(), texts["en"])
    if busctl("org.kde.plasmashell", "/org/kde/osdService",
              "org.kde.osdService", "showText", "ss", icon, text):
        return
    # Notify(app_name, replaces_id, icon, summary, body, actions, hints, timeout)
    busctl("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
           "org.freedesktop.Notifications", "Notify", "susssasa{sv}i",
           "yoga-hotkeys", "0", icon, text, "", "0", "0", "2000")


def star_key(qt_key):
    """A star key was pressed: if nothing uses it, open the settings."""
    out = busctl_out(*KGLOBALACCEL, "getGlobalShortcutsByKey", "i", str(qt_key))
    if out is None or not out.startswith("a(ssssssaiai) 0"):
        return                          # not Plasma, or Plasma runs the shortcut
    show("unassigned")
    for cmd in (["systemsettings", "kcm_keys"], ["kcmshell6", "kcm_keys"]):
        try:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return
        except OSError:
            continue


def read_profile(f):
    f.seek(0)
    return f.read().strip()


def main():
    poller = select.poll()
    keys = profile = None
    last_profile = None
    dimmer = Dimmer()

    try:
        keys = open(KEYS_DEV, "rb", buffering=0)
        poller.register(keys, select.POLLIN)
    except OSError as e:
        print("no camera switch: %s" % e, file=sys.stderr)

    try:
        profile = open(PROFILE)
        # Read before polling: sysfs reports a change only to readers
        # that have read the attribute since the last notification.
        last_profile = read_profile(profile)
        poller.register(profile, select.POLLPRI | select.POLLERR)
    except OSError as e:
        print("no platform profile: %s" % e, file=sys.stderr)

    if keys is None and profile is None:
        return 1

    while True:
        for fd, _ in poller.poll():
            if keys is not None and fd == keys.fileno():
                data = keys.read(EVENT.size)
                if len(data) < EVENT.size:
                    # The device went away; let systemd restart us.
                    return 1
                _, _, etype, code, value = EVENT.unpack(data)
                if etype == EV_MSC and code == MSC_SCAN and value in SCANS:
                    show(SCANS[value])
                elif etype == EV_KEY and value == 1 and code in STAR_KEYS:
                    star_key(STAR_KEYS[code])
            elif profile is not None and fd == profile.fileno():
                now = read_profile(profile)
                if now != last_profile:
                    if now in MESSAGES:
                        show(now)
                    if now == "low-power":
                        dimmer.enter()
                    elif last_profile == "low-power":
                        dimmer.leave()
                last_profile = now


if __name__ == "__main__":
    sys.exit(main())
