"""On-screen message when the hardware camera switch is flipped.

The switch on the Lenovo Yoga Slim 9 14ILL10 cuts the picture in
hardware: the sensor keeps answering and streaming, only every pixel is
zero, and nothing anywhere reports an error. This shows the same kind of
on-screen message Windows does, so a black picture has an explanation.

The embedded controller reports the switch on "Ideapad extra buttons" as
scan code 0x10c (camera on) or 0x10d (camera off). ideapad-laptop has no
key for either, so they arrive as KEY_UNKNOWN and cannot be remapped
through hwdb (EVIOCSKEYCODE rejects scan codes the sparse keymap does not
know). The scan code itself is unambiguous, so it is read directly from
the device, which a udev rule makes readable for the logged-in user.

The message goes to the Plasma OSD (the volume-change popup) when Plasma
is running, and to an ordinary desktop notification otherwise.
"""
import os
import struct
import subprocess
import sys

DEV = sys.argv[1] if len(sys.argv) > 1 else "/dev/input/yoga-camera-switch"

EV_MSC, MSC_SCAN = 4, 4
SCAN_ON, SCAN_OFF = 0x10C, 0x10D

TEXT = {
    "en": ("Camera on", "Camera off"),
    "sk": ("Kamera zapnutá", "Kamera vypnutá"),
    "cs": ("Kamera zapnuta", "Kamera vypnuta"),
}
ICON = {SCAN_ON: "camera-web", SCAN_OFF: "camera-off"}

# struct input_event: struct timeval, __u16 type, __u16 code, __s32 value
EVENT = struct.Struct("llHHi")


def language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "")
        if value:
            return value.split("_")[0].split(".")[0]
    return "en"


def busctl(*args):
    try:
        return subprocess.run(["busctl", "--user", "call", *args],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def show(scan):
    on_text, off_text = TEXT.get(language(), TEXT["en"])
    text = on_text if scan == SCAN_ON else off_text
    icon = ICON[scan]
    if busctl("org.kde.plasmashell", "/org/kde/osdService",
              "org.kde.osdService", "showText", "ss", icon, text):
        return
    # Notify(app_name, replaces_id, icon, summary, body, actions, hints, timeout)
    busctl("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
           "org.freedesktop.Notifications", "Notify", "susssasa{sv}i",
           "camera-switch", "0", icon, text, "", "0", "0", "2000")


def main():
    with open(DEV, "rb", buffering=0) as f:
        while True:
            data = f.read(EVENT.size)
            if len(data) < EVENT.size:
                break
            _, _, etype, code, value = EVENT.unpack(data)
            if etype == EV_MSC and code == MSC_SCAN and value in ICON:
                show(value)
    # The device went away; let systemd restart us.
    return 1


if __name__ == "__main__":
    sys.exit(main())
